# Symfony app path (mounted into php/nginx containers)
APP_PATH=../app

# Custom php.ini overrides directory (mounted read-only, see docker/php/conf.d)
PHP_CONFIG_PATH=./php/conf.d

# Owner UID/GID for the unprivileged user inside the PHP container.
# Defaults match the standard first Linux desktop user (1000:1000).
UID=1000
GID=1000

# Docker network
NETWORK_NAME=codehub
NETWORK_SUBNET=172.29.0.0/24

# NGINX
NGINX_PORT=8088

# Xdebug (docker)
XDEBUG_MODE=debug
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
XDEBUG_IDE_KEY=PHPSTORM
XDEBUG_SERVER_NAME=codehub
